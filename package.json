{
  "name": "smile-watch-app",
  "version": "3.0.0",
  "private": true,
  "description": "PC のインカメラで表情とまぶたの動きを読み取り、笑顔が少ない状態や眠気のサインが続いたら声をかけるアプリケーション",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node tests/calibrate.test.mjs && node tests/run.mjs",
